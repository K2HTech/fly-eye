#!/bin/sh

commit_msg_file=$1
subject=$(sed -n '1p' "$commit_msg_file")

conventional_pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]].*$'

if printf '%s\n' "$subject" | grep -Eq "$conventional_pattern"; then
    exit 0
fi

case "$subject" in
    "Merge "*|"Revert \""*"\"")
        exit 0
        ;;
esac

cat >&2 <<'EOF'
Invalid commit message.

Use Conventional Commits:
  <type>(optional-scope): <description>

Allowed types:
  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert

Examples:
  feat(core): add camera calibration model
  fix(desktop): prevent empty video selection
  docs: document branching workflow

See docs/commit-convention.md for details.
EOF

exit 1
